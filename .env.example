# Copier en .env.local (développement) ou renseigner dans les réglages de l’hébergeur (production).
# Ne jamais committer les vraies valeurs.

# URL publique du site (métadonnées, sitemap, URLs de retour Stripe)
NEXT_PUBLIC_SITE_URL=https://maisonkayes.be

# Base de données Postgres (Neon, Supabase, Vercel Postgres…). Obligatoire en production.
# Sans valeur : base locale PGlite dans .data/pglite (développement uniquement).
DATABASE_URL=
# Taille du pool de connexions (facultatif, 5 par défaut)
# DATABASE_POOL_MAX=5

# Stripe — Tableau de bord → Développeurs → Clés API (sk_test_… pour les tests, sk_live_… en production)
STRIPE_SECRET_KEY=
# Stripe — Développeurs → Webhooks → endpoint https://<domaine>/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Tarifs de livraison (Produits → Tarifs de livraison), identifiants shr_…
# Une zone laissée vide n’est pas proposée.
STRIPE_SHIPPING_RATE_BE=
STRIPE_SHIPPING_RATE_EU=
# Suisse, Royaume-Uni, Norvège, Islande (droits de douane possibles) — facultatif
STRIPE_SHIPPING_RATE_EUROPE=

# E-mails de commande (Resend — https://resend.com)
# Clé d’API : Resend → API Keys (droit « Sending access » suffit)
RESEND_API_KEY=
# Expéditeur sur le domaine vérifié dans Resend (Domains), ex. maisonkayes.be
EMAIL_FROM="Maison Kayes <commandes@maisonkayes.be>"
# Adresse de réponse des clients (contact@maisonkayes.be par défaut)
EMAIL_REPLY_TO=contact@maisonkayes.be
# Adresse de gestion qui reçoit « Nouvelle commande à préparer » (contact@maisonkayes.be par défaut)
ORDER_NOTIFICATION_EMAIL=contact@maisonkayes.be
