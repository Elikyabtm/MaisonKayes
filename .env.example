# Copier en .env.local (développement) ou renseigner dans les réglages de l’hébergeur (production).
# Ne jamais committer les vraies valeurs.

# URL publique du site (métadonnées, sitemap, URLs de retour Stripe)
NEXT_PUBLIC_SITE_URL=https://maisonkayes.be

# Stripe — Tableau de bord → Développeurs → Clés API (sk_test_… pour les tests, sk_live_… en production)
STRIPE_SECRET_KEY=
# Stripe — Développeurs → Webhooks → endpoint https://<domaine>/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Tarifs de livraison (Produits → Tarifs de livraison), identifiants shr_…
# Une zone laissée vide n’est pas proposée.
STRIPE_SHIPPING_RATE_BE=
STRIPE_SHIPPING_RATE_EU=
# Suisse, Royaume-Uni, Norvège, Islande (droits de douane possibles) — facultatif
STRIPE_SHIPPING_RATE_EUROPE=
